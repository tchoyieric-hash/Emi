FROM node:20-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY package.json ./
RUN npm install --omit=dev
COPY scripts/whatsapp-emi-bot.mjs ./scripts/whatsapp-emi-bot.mjs
# Mount a persistent volume at /data to retain the WhatsApp device session.
ENV WHATSAPP_AUTH_DIR=/data/whatsapp-emi-auth
CMD ["node", "scripts/whatsapp-emi-bot.mjs"]
